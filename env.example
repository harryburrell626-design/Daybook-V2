# Copy to .env and edit. Never commit .env.

# Used ONLY by scripts/setup-db.js (creates the database and roles). Not used by the running app.
PG_SUPERUSER_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/postgres
DB_NAME=daybook
DB_HOST=127.0.0.1
DB_PORT=5432

# Three separate roles with three separate passwords (setup-db.js creates them)
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
DB_AUTH_PASSWORD=change-me-auth

PORT=3000
# Public URL of the site (used in password-reset links)
APP_URL=http://localhost:3000
# Set to production when served over HTTPS (turns on Secure cookies, HSTS, hides dev helpers)
NODE_ENV=development
# Behind a reverse proxy (nginx, Caddy, Render, Fly...)? set to 1
TRUST_PROXY=0

# Password-reset email (https://resend.com). Without these the reset link is printed to the server log.
RESEND_API_KEY=
MAIL_FROM=Daybook <noreply@example.com>

# LOCAL DEVELOPMENT ONLY: show the reset link on screen instead of emailing it. Ignored in production.
DEV_SHOW_RESET_LINK=1
